{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user workspace preferences without PII fields.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "preferredVoice": {
          "type": "string",
          "enum": ["Zephyr", "Puck", "Charon", "Kore", "Fenrir"]
        },
        "speakingStyle": {
          "type": "string",
          "enum": ["concise", "natural", "technical", "warm"]
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["auto", "en", "ur", "ur-Latn"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredVoice", "speakingStyle", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "Explicitly user-approved long-term memory entry.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "enum": ["preference", "project", "fact", "instruction"]
        },
        "source": {
          "type": "string",
          "enum": ["voice", "text", "manual"]
        },
        "approvedByUser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "fact", "category", "source", "approvedByUser", "createdAt", "updatedAt"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "Persistent multimodal voice or text conversation session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": ["voice", "text", "multimodal"]
        },
        "language": {
          "type": "string",
          "enum": ["auto", "en", "ur", "ur-Latn"]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "mode", "language", "summary", "messageCount", "createdAt", "updatedAt"]
    },
    "SessionMessage": {
      "title": "SessionMessage",
      "description": "Individual conversation turn persisted in a session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "system"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "modality": {
          "type": "string",
          "enum": ["voice", "text"]
        },
        "agentRoute": {
          "type": "string",
          "maxLength": 64
        },
        "latencyMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "sessionId", "role", "content", "modality", "createdAt"]
    },
    "KnowledgeDocument": {
      "title": "KnowledgeDocument",
      "description": "Metadata for an uploaded RAG knowledge document.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sizeBytes": {
          "type": "integer"
        },
        "chunkCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["processing", "indexed", "error"]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "filename", "mimeType", "sizeBytes", "chunkCount", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and observability event log without PII.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "enum": ["tool_call", "memory_consent", "rag_ingest", "a2a_dispatch", "security_guard", "voice_session"]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["success", "denied", "error"]
        },
        "latencyMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "eventType", "action", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User workspace configuration and voice preferences."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/UserMemory" },
      "description": "User-approved long-term memories."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ConversationSession" },
      "description": "Conversation session metadata and compressed summaries."
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SessionMessage" },
      "description": "Conversation turns inside a session."
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/KnowledgeDocument" },
      "description": "Uploaded knowledge base document metadata."
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and tool execution audit logs."
    }
  }
}
