# GEMINI_API_KEY: Required for Gemini AI API calls (Live API, Orchestrator, Embeddings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000 in AI Studio, 8080 on Cloud Run if configured)
PORT=3000

# RATE_LIMIT_MAX_RPM: Per-client API requests allowed per minute
RATE_LIMIT_MAX_RPM=90
